# ------------------------------------------------------------------
# Public site URL (used for metadata, sitemap, auth redirects)
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------
# Supabase — Project Settings → API
# Leave empty to run the public site in demo mode (no persistence,
# no authentication). The dashboard requires these values.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
# Required for the contact form and for persisting checkout orders. If the URL
# and anon key are set but this key is missing, those two features fail closed
# (503 / disabled UI) instead of writing through the public anon key.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Payments
# Only the sandbox provider is implemented. No real charge is made.
# Any PAYMENT_PROVIDER value other than "sandbox" fails closed (503).
# Set PAYMENTS_SANDBOX=false to disable checkout in the UI and API.
# ------------------------------------------------------------------
PAYMENT_PROVIDER=sandbox
PAYMENTS_SANDBOX=true

# HMAC-SHA256 secret used by /api/payments/webhook (server only).
# Generate with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
